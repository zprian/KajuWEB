---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

export interface Props {
  title: string;
  lang?: Lang;
  description?: string;
}

const { title, lang: langProp, description = 'Kajukenbo Catalunya - Arte Marcial de Hawaii' } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Kajukenbo Catalunya</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href={Astro.site?.toString() ?? '/'} />
    <link rel="alternate" hreflang="en" href={`${Astro.site ?? ''}/en`} />
    <link rel="alternate" hreflang="ca" href={`${Astro.site ?? ''}/ca`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-kaju-dark text-kaju-light min-h-screen flex flex-col">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
