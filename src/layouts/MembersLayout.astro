---
import Layout from './Layout.astro';
import { getLangFromUrl, useTranslations, getLocalePath, type Lang } from '../i18n/utils';

export interface Props {
  title: string;
  lang?: Lang;
  userName?: string;
  belt?: string;
}

const { title, lang: langProp, userName, belt } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={title} lang={lang}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row gap-6">
      <!-- Sidebar -->
      <aside class="w-full md:w-64 shrink-0">
        <div class="bg-kaju-gray rounded-xl p-6 mb-4">
          <p class="text-white font-semibold text-sm uppercase tracking-wider mb-1">{t.members.welcome}</p>
          {userName && <p class="text-white text-lg font-bold">{userName}</p>}
          {belt && (
            <div class="mt-3 flex items-center gap-2">
              <div class="w-6 h-1.5 rounded-full" style={`background: var(--belt-${belt}, #fff)`}></div>
              <span class="text-sm text-gray-300 capitalize">
                {t.members.beltLabel[belt as keyof typeof t.members.beltLabel] ?? belt}
              </span>
            </div>
          )}
        </div>
        <nav class="space-y-1">
          <a href={getLocalePath(lang, 'members')} class="block px-4 py-2 rounded-lg text-gray-300 hover:bg-kaju-gray hover:text-white transition">
            {t.members.dashboard}
          </a>
          <a href={getLocalePath(lang, 'members/profile')} class="block px-4 py-2 rounded-lg text-gray-300 hover:bg-kaju-gray hover:text-white transition">
            {t.members.profile}
          </a>
          <form action="/api/auth/logout" method="POST">
            <button type="submit" class="w-full text-left px-4 py-2 rounded-lg text-gray-400 hover:bg-kaju-gray hover:text-white transition">
              {t.nav.logout}
            </button>
          </form>
        </nav>
      </aside>
      <!-- Content -->
      <div class="flex-1 min-w-0">
        <slot />
      </div>
    </div>
  </div>
</Layout>

<style>
  :root {
    --belt-white: #ffffff;
    --belt-yellow: #f5c518;
    --belt-orange: #f97316;
    --belt-purple: #a855f7;
    --belt-blue: #3b82f6;
    --belt-green: #22c55e;
    --belt-brown: #92400e;
    --belt-black: #1a1a1a;
  }
</style>
