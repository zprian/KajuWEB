---
import Layout from './Layout.astro';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';
import { getEffectiveRole, VIEW_AS_ROLES } from '../lib/view-as';

export interface Props {
  title: string;
  lang?: Lang;
  userName?: string;
  belt?: string;
  isAdmin?: boolean;
  role?: string;
}

const { title, lang: langProp, userName, belt, isAdmin = false, role } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const actualRole = role ?? (isAdmin ? 'instructor' : 'member');
const effectiveRole = getEffectiveRole(Astro.cookies, actualRole);
const canSwitchView = actualRole === 'admin';
const canManageUsers = isAdmin && effectiveRole !== 'member';
const initials = (userName ?? 'K').split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]).join('').toUpperCase();
const privateCopy = {
  es: { privateArea: 'Área privada', training: 'Entrenamiento', announcements: 'Avisos', profile: 'Mi perfil', manageUsers: 'Gestionar usuarios', logout: 'Cerrar sesión' },
  en: { privateArea: 'Private area', training: 'Training', announcements: 'Announcements', profile: 'My profile', manageUsers: 'Manage users', logout: 'Log out' },
  ca: { privateArea: 'Àrea privada', training: 'Entrenament', announcements: 'Avisos', profile: 'El meu perfil', manageUsers: 'Gestionar usuaris', logout: 'Tancar sessió' },
}[lang];
---

<Layout title={title} lang={lang}>
  <div class="mx-auto max-w-7xl px-5 py-8 sm:px-8 lg:px-10 lg:py-12">
    <div class="mb-8 flex flex-col justify-between gap-5 border-b border-white/10 pb-7 sm:flex-row sm:items-center">
      <div>
        <p class="text-[0.68rem] font-bold uppercase tracking-[0.28em] text-kaju-red">{privateCopy.privateArea}</p>
        <p class="mt-2 text-sm text-white/45">{userName || t.members.welcome}</p>
      </div>
      <div class="flex items-center gap-2 self-start sm:self-auto">
        {canSwitchView && <label class="flex items-center rounded-full border border-white/10 bg-white/5 px-2 py-1.5"><span class="sr-only">{lang === 'en' ? 'View as role' : lang === 'ca' ? 'Veure com a rol' : 'Visualizar como rol'}</span><select data-view-role aria-label={lang === 'en' ? 'View as role' : lang === 'ca' ? 'Veure com a rol' : 'Visualizar como rol'} class="bg-transparent px-2 text-xs text-white/70 outline-none"><option value="admin" selected={effectiveRole === 'admin'}>{lang === 'en' ? 'Admin' : 'Admin'}</option><option value="instructor" selected={effectiveRole === 'instructor'}>{lang === 'en' ? 'Master' : lang === 'ca' ? 'Mestre' : 'Maestro'}</option><option value="member" selected={effectiveRole === 'member'}>{lang === 'en' ? 'Member' : lang === 'ca' ? 'Membre' : 'Miembro'}</option></select></label>}
      <details class="group relative">
        <summary class="flex cursor-pointer list-none items-center gap-3 rounded-full border border-white/10 bg-white/5 py-1.5 pl-2 pr-4 transition hover:border-white/25 hover:bg-white/10">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-kaju-red text-xs font-bold text-white">{initials}</span>
          <span class="text-sm font-semibold text-white">{userName || t.members.profile}</span>
          <span class="text-xs text-white/40 transition group-open:rotate-180">⌄</span>
        </summary>
        <div class="absolute right-0 z-30 mt-2 w-52 overflow-hidden rounded-2xl border border-white/10 bg-[#1b1b1e] p-2 shadow-2xl">
          <a href="/members/profile" class="block rounded-xl px-3 py-2.5 text-sm text-white/70 transition hover:bg-white/10 hover:text-white">{privateCopy.profile}</a>
          <form action="/api/auth/logout" method="POST">
            <button type="submit" class="w-full rounded-xl px-3 py-2.5 text-left text-sm text-white/45 transition hover:bg-white/10 hover:text-white">{privateCopy.logout}</button>
          </form>
        </div>
      </details>
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-[15rem_1fr] lg:gap-12">
      <aside>
        <nav aria-label={privateCopy.privateArea} class="grid gap-2 sm:grid-cols-2 lg:grid-cols-1">
          <a href="/members/training" class="group rounded-2xl border border-white/10 bg-[#141416] p-4 transition hover:border-kaju-red/50 hover:bg-[#19191c]">
            <span class="mb-5 flex h-9 w-9 items-center justify-center rounded-full bg-kaju-red/15 text-lg text-kaju-red">↗</span>
            <span class="block text-sm font-bold uppercase tracking-[0.12em] text-white">{privateCopy.training}</span>
            <span class="mt-1 block text-xs leading-5 text-white/40">{lang === 'en' ? 'Techniques and lessons' : lang === 'ca' ? 'Tècniques i lliçons' : 'Técnicas y lecciones'}</span>
          </a>
          <a href="/members/announcements" class="group rounded-2xl border border-white/10 bg-[#141416] p-4 transition hover:border-kaju-red/50 hover:bg-[#19191c]">
            <span class="mb-5 flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-lg text-white">!</span>
            <span class="block text-sm font-bold uppercase tracking-[0.12em] text-white">{privateCopy.announcements}</span>
            <span class="mt-1 block text-xs leading-5 text-white/40">{lang === 'en' ? 'Events and club news' : lang === 'ca' ? 'Esdeveniments i notícies' : 'Eventos y novedades'}</span>
          </a>
          {canManageUsers && <a href="/members/admin/users" class="group rounded-2xl border border-kaju-red/30 bg-kaju-red/10 p-4 transition hover:border-kaju-red/60 hover:bg-kaju-red/15">
            <span class="mb-5 flex h-9 w-9 items-center justify-center rounded-full bg-kaju-red text-lg text-white">+</span>
            <span class="block text-sm font-bold uppercase tracking-[0.12em] text-white">{privateCopy.manageUsers}</span>
            <span class="mt-1 block text-xs leading-5 text-white/40">{lang === 'en' ? 'Members, roles and invitations' : lang === 'ca' ? 'Membres, rols i invitacions' : 'Miembros, roles e invitaciones'}</span>
          </a>}
        </nav>
      </aside>

      <div class="min-w-0">
        <slot />
      </div>
    </div>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-view-role]').forEach((selector) => {
    selector.addEventListener('change', () => {
      document.cookie = `kaju_view_as=${encodeURIComponent(selector.value)}; path=/; SameSite=Lax`;
      window.location.reload();
    });
  });
</script>
