---
import LanguageSelector from './LanguageSelector.astro';
import { useTranslations, getLocalePath, type Lang } from '../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const navLabels = {
  es: { history: 'Historia', method: 'Método', classes: 'Clases', news: 'Actualidad' },
  en: { history: 'History', method: 'Method', classes: 'Classes', news: 'Current' },
  ca: { history: 'Història', method: 'Mètode', classes: 'Classes', news: 'Actualitat' },
}[lang];

const navItems = [
  { href: `${getLocalePath(lang)}#historia`, label: navLabels.history },
  { href: `${getLocalePath(lang)}#metodo`, label: navLabels.method },
  { href: `${getLocalePath(lang)}#clases`, label: navLabels.classes },
  { href: `${getLocalePath(lang)}#noticias`, label: navLabels.news },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#0b0b0c]/90 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={getLocalePath(lang)} class="group flex items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-kaju-red/70 text-xs font-black text-kaju-red transition group-hover:bg-kaju-red group-hover:text-white">K</span>
        <span class="font-heading text-xl font-semibold uppercase tracking-[0.06em] text-white">Kajukenbo <span class="text-kaju-red">CAT</span></span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class="rounded-lg px-3 py-2 text-[0.68rem] font-bold uppercase tracking-[0.16em] text-white/[.55] transition hover:bg-white/5 hover:text-white"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Right actions -->
      <div class="flex items-center gap-3">
        <LanguageSelector lang={lang} />
        <a
          href={getLocalePath(lang, 'members')}
          class="hidden items-center rounded-full bg-kaju-red px-4 py-2 text-[0.68rem] font-bold uppercase tracking-[0.14em] text-white transition hover:bg-red-700 sm:inline-flex"
        >
          {t.nav.miembros}
        </a>

        <!-- Mobile menu button -->
        <button
          id="menu-btn"
          class="rounded-lg p-2 text-white/50 transition hover:bg-white/5 hover:text-white lg:hidden"
          aria-label="Open menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav -->
    <nav id="mobile-menu" class="mt-2 hidden border-t border-white/10 pb-3 pt-3 lg:hidden">
      {navItems.map(item => (
        <a
          href={item.href}
          class="block rounded-lg px-3 py-2 text-sm text-white/60 transition hover:bg-white/5 hover:text-white"
        >
          {item.label}
        </a>
      ))}
      <a
        href={getLocalePath(lang, 'members')}
        class="mt-2 block px-3 py-2 text-sm font-bold uppercase tracking-[0.14em] text-kaju-red"
      >
        {t.nav.miembros}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
