  en: {
    title: 'Kajukenbo Catalunya',
    description: 'Kajukenbo Catalunya · self-defence, discipline and adaptability.',
    heroEyebrow: 'Self-defence system · Catalunya',
    heroTitle: 'Train to be ready.',
    heroText: 'A martial art born from combination, tested in reality and passed on with respect.',
    primary: 'Explore the method',
    secondary: 'View classes',
    signal: 'Movement · control · judgement',
    originKicker: '01 / Origin',
    originTitle: 'A discipline with roots. A practice for today.',
    originText: 'Kajukenbo was born in Hawaii between 1947 and 1949 through the meeting of five martial artists. Its spirit remains direct: keep what works, adapt it to the context and train it honestly.',
    originLink: 'Read the full history',
    methodKicker: '02 / The method',
    methodTitle: 'Five paths. One system.',
    methodText: 'Striking, distance, control and adaptation meet in a demanding, progressive practice open to every level.',
    methodCards: [
      ['Realism', 'Techniques that start from concrete situations and clear decisions.'],
      ['Adaptability', 'A living system that tests, learns and evolves.'],
      ['Progression', 'A visible path from the very first belt.'],
      ['Community', 'Train together with respect, rigor and camaraderie.'],
    ],
    lineageKicker: '03 / Lineage',
    lineageTitle: 'From Palama Settlement to Catalunya.',
    lineageText: 'History matters because it gives practice its context. Teaching continues when each generation trains with judgement and takes care of what it has received.',
    milestones: [
      ['1947', 'The founders begin training together in Hawaii.'],
      ['1949', 'The system takes shape through testing and adaptation.'],
      ['1950', 'Kajukenbo begins to be taught publicly.'],
      ['Today', 'An international community keeps the spirit moving.'],
    ],
    classesKicker: '04 / At the dojo',
    classesTitle: 'Come train.',
