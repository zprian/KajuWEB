      ['Hoy', 'Una comunidad internacional mantiene el espíritu en movimiento.'],
    ],
    classesKicker: '04 / En el dojo',
    classesTitle: 'Ven a entrenar.',
    classesText: 'Clases para descubrir el sistema, mejorar tu condición y construir confianza paso a paso.',
    classesCta: 'Escríbenos por Instagram',
    newsKicker: '05 / Actualidad',
