    finalKicker: '¿Listo para empezar?',
    finalTitle: 'El primer paso es aparecer.',
    finalText: 'Conoce el grupo, prueba una clase y descubre si Kajukenbo es para ti.',
    finalCta: 'Escríbenos por Instagram',
