    originText: 'El Kajukenbo va néixer a Hawaii entre 1947 i 1949 a partir de la trobada de cinc artistes marcials. El seu esperit continua sent directe: conservar el que funciona, adaptar-lo al context i entrenar-lo amb honestedat.',
    originLink: 'Llegir la història completa',
    methodKicker: '02 / El mètode',
    methodTitle: 'Cinc camins. Un sistema.',
    methodText: 'Cops, distància, control i adaptació es troben en una pràctica exigent, progressiva i oberta a tots els nivells.',
    methodCards: [
      ['Realisme', 'Tècniques que parteixen de situacions concretes i decisions clares.'],
      ['Adaptació', 'Un sistema viu que aprèn, prova i evoluciona.'],
      ['Progressió', 'Una ruta de treball visible des del primer cinturó.'],
      ['Comunitat', 'Entrenar junts amb respecte, rigor i companyonia.'],
    ],
    lineageKicker: '03 / Llinatge',
    lineageTitle: 'De Palama Settlement a Catalunya.',
    lineageText: 'La història importa perquè dona context a la pràctica. L’ensenyament continua quan cada generació entrena amb criteri i cuida el que ha rebut.',
    milestones: [
      ['1947', 'Els fundadors comencen a entrenar junts a Hawaii.'],
      ['1949', 'El sistema pren forma a través de la prova i l’adaptació.'],
      ['1950', 'El Kajukenbo comença a ensenyar-se públicament.'],
      ['Avui', 'Una comunitat internacional manté l’esperit en moviment.'],
    ],
    classesKicker: '04 / Al dojo',
    classesTitle: 'Vine a entrenar.',
    classesText: 'Classes per descobrir el sistema, millorar la teva condició i construir confiança pas a pas.',
    classesCta: 'Escriu-nos per Instagram',
    newsKicker: '05 / Actualitat',
    newsTitle: 'El que està passant.',
    instagramKicker: '06 / Comunitat',
    instagramTitle: 'L’entrenament també continua fora del dojo.',
    instagramCta: 'Segueix-nos a Instagram',
    finalKicker: 'Preparat per començar?',
    finalTitle: 'El primer pas és venir.',
    finalText: 'Coneix el grup, prova una classe i descobreix si el Kajukenbo és per a tu.',
    finalCta: 'Escriu-nos per Instagram',
    belts: 'Una ruta d’aprenentatge',
  },
