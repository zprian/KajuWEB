---
import { useTranslations, getLocalePath, type Lang } from '../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-white/10 bg-[#080809]">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-10 sm:px-8 lg:px-10">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
      <a href={getLocalePath(lang)} class="group flex items-center gap-3 font-heading text-2xl font-semibold uppercase tracking-[0.06em] text-white">
        <img src="/images/kajukenbo-garcias-method.png" alt="Kajukenbo Garcia's Method" class="h-10 w-10 object-contain transition group-hover:scale-105" />
        <span>Kajukenbo <span class="text-kaju-red">CAT</span></span>
      </a>
      <div class="flex flex-wrap gap-x-5 gap-y-2 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-white/40">
        <a href="#historia" class="transition hover:text-white">Historia</a>
        <a href="#metodo" class="transition hover:text-white">Método</a>
        <a href="#clases" class="transition hover:text-white">Clases</a>
        <a href="#noticias" class="transition hover:text-white">Actualidad</a>
      </div>
    </div>
    <div class="flex flex-col justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center">
    <p class="text-sm text-white/[.35]">
      &copy; {year} Kajukenbo Catalunya. {t.footer.rights}
    </p>
    <div class="flex items-center gap-4">
      <a href="https://www.instagram.com/kajukenbobcn/" target="_blank" rel="noopener noreferrer" class="text-white/[.35] transition hover:text-white" aria-label="Instagram">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>
    </div>
    </div>
  </div>
</footer>
