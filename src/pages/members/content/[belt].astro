---
export const prerender = false;
import MembersLayout from '../../../layouts/MembersLayout.astro';
import { getLangFromUrl, useTranslations, canAccessBelt, BELT_ORDER } from '../../../i18n/utils';
import { createSupabaseServerClient } from '../../../lib/supabase-server';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { belt: requestedBelt } = Astro.params;

// Validate belt param
if (!requestedBelt || !(requestedBelt in BELT_ORDER)) {
  return Astro.redirect('/members');
}

const supabase = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', user!.id)
  .single();

const userBelt = profile?.belt ?? 'white';

// Check access
if (!canAccessBelt(userBelt, requestedBelt)) {
  return Astro.redirect('/members?error=forbidden');
}

const userName = profile ? `${profile.name} ${profile.surname}` : '';
const beltLabel = t.members.beltLabel[requestedBelt as keyof typeof t.members.beltLabel] ?? requestedBelt;
---

<MembersLayout title={`${beltLabel} - ${t.members.content}`} lang={lang} userName={userName} belt={userBelt}>
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <div class="w-8 h-2.5 rounded-full" style={`background: var(--belt-${requestedBelt})`}></div>
      <h1 class="text-2xl font-bold text-white capitalize">{beltLabel}</h1>
    </div>

    <div class="bg-kaju-gray rounded-2xl p-8 text-center">
      <div class="w-16 h-16 mx-auto mb-4 bg-kaju-red/10 rounded-2xl flex items-center justify-center">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>
      <p class="text-gray-300 text-lg mb-2">
        Contenido del cinturón <strong class="text-white capitalize">{beltLabel}</strong>
      </p>
      <p class="text-gray-500 text-sm max-w-md mx-auto">
        Este es el área de contenido para el cinturón {beltLabel}. El administrador puede añadir técnicas, vídeos, documentos y materiales de entrenamiento desde el panel de TinaCMS.
      </p>
    </div>

    <!-- Content will be loaded from TinaCMS -->
    <!-- Placeholder: each belt's .md file in content/members/ will be rendered here -->
  </div>
</MembersLayout>

<style>
  :root {
    --belt-white: #ffffff; --belt-yellow: #f5c518; --belt-orange: #f97316;
    --belt-purple: #a855f7; --belt-blue: #3b82f6; --belt-green: #22c55e;
    --belt-brown: #92400e; --belt-black: #555;
  }
</style>
