# Supabase – get these from your Supabase project dashboard (Settings > API)
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only key for future admin/storage operations.
# Never expose this value to browser code or commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=

# TinaCloud – get these from app.tina.io after creating a project
TINA_CLIENT_ID=
TINA_TOKEN=

# GitHub branch TinaCMS will write to
GITHUB_BRANCH=main
